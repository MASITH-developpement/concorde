<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import FEC : fiche -->
    <record id="view_concorde_import_form" model="ir.ui.view">
        <field name="name">concorde.import.form</field>
        <field name="model">concorde.import</field>
        <field name="arch" type="xml">
            <form string="Import FEC CONCORDE">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="analyse_ok,importe,erreur"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="fec_filename"/>
                            <field name="journal_id" options="'{"no_create": True}'"/>
                            <field name="empreinte_guardian"/>
                        </group>
                        <group>
                            <field name="nb_lignes"/>
                            <field name="nb_ecritures"/>
                            <field name="nb_paires"/>
                            <field name="nb_anomalies"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                        </group>
                    </group>
                    <field name="comptes_manquants" invisible="1"/>
                    <notebook>
                        <page string="Rapport pipeline">
                            <field name="rapport_html" nolabel="1"/>
                        </page>
                        <page string="Écritures Odoo">
                            <field name="move_ids">
                                <tree>
                                    <field name="ref"/>
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                    <field name="amount_total"/>
                                    <field name="state" widget="b
adge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Import FEC : liste -->
    <record id="view_concorde_import_tree" model="ir.ui.view">
        <field name="name">concorde.import.tree</field>
        <field name="model">concorde.import</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('analyse_ok','importe')"
                       decoration-danger="state == 'erreur'"/>
                <field name="nb_lignes"/>
                <field name="nb_anomalies"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Assistant d'import -->
    <record id="view_concorde_import_wizard" model="ir.ui.view">
        <field name="name">concorde.import.wizard.form</field>
        <field name="model">concorde.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer un FEC (Quadra)">
                <group>
                    <field name="fec_filename" invisible="1"/>
                    <field name="fec_file" filename="fec_filename"/>
                    <field name="journal_id"/>
                    <field name="dry_run"/>
                </group>
                <footer>
                    <button string="Analyser et importer" name="action_importer"
                            type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_concorde_import" model="ir.actions.act_window">
        <field name="name">Imports FEC</field>
        <field name="res_model">concorde.impo
rt</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_concorde_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer un FEC</field>
        <field name="res_model">concorde.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_concorde_root" name="CONCORDE" sequence="60"/>
    <menuitem id="menu_concorde_importer" name="Importer un FEC"
              parent="menu_concorde_root" action="action_concorde_import_wizard"
              sequence="5"/>
    <menuitem id="menu_concorde_imports" name="Historique des imports"
              parent="menu_concorde_root" action="action_concorde_import"
              sequence="10"/>
</odoo>

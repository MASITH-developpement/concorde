# CONCORDE — analyse antivirus ClamAV de nuit (ADR-0007). Lancé par concorde-antivirus.timer.
# Signatures : mises à jour toutes les heures par clamav-freshclam ; vérifiées (< 48 h) à chaque contrôle.
[Unit]
Description=CONCORDE - analyse antivirus ClamAV (nuit)
After=docker.service clamav-freshclam.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/concorde/securite/concorde_securite.py antivirus
SuccessExitStatus=2
Nice=19
IOSchedulingClass=idle
CPUQuota=60%
MemoryMax=1536M
TimeoutStartSec=6h
